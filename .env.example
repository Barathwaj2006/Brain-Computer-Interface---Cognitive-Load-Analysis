# =============================================================================
# NEUROSIM : ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your cloud backend credentials
# =============================================================================

# Server Ports (Default: HTTP 8000, WebSocket 8765, UDP 5005)
PORT=8000
HTTP_PORT=8000
WS_PORT=8765
UDP_PORT=5005

# -----------------------------------------------------------------------------
# Supabase PostgreSQL Cloud Database Configuration
# -----------------------------------------------------------------------------
# Option A: Full Connection URI (Recommended - from Supabase Settings -> Database)
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres.ymxlupetcfdazbaumwqm:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Option B: Structured Project Variables (Auto-assembled by server.py)
SUPABASE_PROJECT_REF=ymxlupetcfdazbaumwqm
SUPABASE_DB_PASSWORD=
SUPABASE_REGION=aws-0-us-east-1

# Supabase REST & Auth Keys (Optional, for client-side SDK integration)
SUPABASE_URL=https://ymxlupetcfdazbaumwqm.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
